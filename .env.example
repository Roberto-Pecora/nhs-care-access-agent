# MCP server. Point NHS_MCP_CWD at a checkout of nhs-intelligence-mcp.
NHS_MCP_COMMAND=uv
NHS_MCP_ARGS=run,nhs-intel-mcp
NHS_MCP_CWD=/absolute/path/to/nhs-intelligence-mcp

# Model selection: local, gemini, or hosted.
MODEL_BACKEND=local
MAX_TOOL_CALLS=8
MAX_AGENT_TURNS=12

# Local Qwen through llama-server, vLLM, or another OpenAI-compatible server.
LOCAL_MODEL=Qwen/Qwen3-8B
LOCAL_BASE_URL=http://localhost:8080/v1
LOCAL_API_KEY=

# Gemini Flash. Do not use the free tier with sensitive user data.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_KEY=

# Any OpenAI-compatible hosted endpoint, for example a pinned Qwen or DeepSeek
# deployment. Record the provider, region, model revision, and price in an eval run.
HOSTED_MODEL=
HOSTED_BASE_URL=
HOSTED_API_KEY=

# Optional JSONL trace output. Keep this outside version control.
TRACE_PATH=artifacts/traces.jsonl
